# ---------- Etapa 1: Build con Node ----------
FROM node:20-alpine AS builder

WORKDIR /app

# Copiamos solo lo necesario para instalar deps y buildear
COPY package.json ./
# Si tienes package-lock.json, puedes copiarlo también:
# COPY package-lock.json ./

COPY vite.config.js ./
COPY tailwind.config.js ./
COPY postcss.config.js ./
COPY index.html ./

RUN npm install --legacy-peer-deps

# Ahora sí, copiamos el código fuente
COPY src ./src
COPY public ./public

# Build de producción (genera /dist)
RUN npm run build


# ---------- Etapa 2: Servir con Nginx ----------
FROM nginx:stable-alpine

# Copiamos el build estático al docroot de Nginx
COPY --from=builder /app/dist /usr/share/nginx/html

# Opcional: custom nginx.conf si quieres, por ahora usamos el default

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
